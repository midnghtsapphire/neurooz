# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (used in supabase/functions/create-checkout and check-subscription)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# Optional — AI/LLM
OPENAI_API_KEY=sk-...  # For future Brain Dump AI processing
VITE_OPENROUTER_API_KEY=your-openrouter-key

# Server-side key for Supabase Edge Functions (voice-to-text, brain-melee-chat, process-brain-dump)
OPENROUTER_API_KEY=sk-or-...

# Analytics (opt-in)
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_KEY=

# Production canonical URL is https://neurooz.com (Cloudflare Pages).
# Local Vite port is 8080 (vite.config.ts).
# VITE_APP_URL=http://localhost:5173
VITE_APP_URL=http://localhost:8080

# Deploys run on your machine. Do not commit real values.
# Cloudflare: `npx wrangler login` once, or export CLOUDFLARE_API_TOKEN in the shell.
# CLOUDFLARE_API_TOKEN=
# DigitalOcean failover droplet (npm run deploy:do):
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PATH=/home/ubuntu/neurooz/dist
# DEPLOY_SSH_KEY=
